def alpha_beta(node, alpha, beta, maximizing):
    
    if isinstance(node, int):
        print("Visited leaf:", node)
        return node

    if maximizing:
        value = float('-inf')
        print("\nMAX Node")

        for i, child in enumerate(node):
            result = alpha_beta(child, alpha, beta, False)

            value = max(value, result)
            alpha = max(alpha, value)

            print("MAX value:", value)
            print("Alpha:", alpha, "Beta:", beta)

            if alpha >= beta:
                print("Pruned subtree:", node[i+1:])
                break

        return value

    else:
        value = float('inf')
        print("\nMIN Node")

        for i, child in enumerate(node):
            result = alpha_beta(child, alpha, beta, True)

            value = min(value, result)
            beta = min(beta, value)

            print("MIN value:", value)
            print("Alpha:", alpha, "Beta:", beta)

            if alpha >= beta:
                print("Pruned subtree:", node[i+1:])
                break

        return value

def input_tree():

    n = int(input("Enter number of children: "))

    children = []

    for i in range(n):
        print("\nChild", i+1)

        choice = input(
            "Enter L for leaf node or N for internal node: "
        ).upper()

        if choice == 'L':
            value = int(input("Enter leaf value: "))
            children.append(value)

        elif choice == 'N':
            print("Enter child nodes:")
            children.append(input_tree())

        else:
            print("Invalid choice. Try again.")
            children.append(input_tree())

    return children



