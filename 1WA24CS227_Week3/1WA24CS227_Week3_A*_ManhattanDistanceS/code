
def manhattan_distance(state, goal):
    distance = 0

    for i in range(3):
        for j in range(3):

            tile = state[i][j]

            if tile == 0:
                continue

            for x in range(3):
                for y in range(3):

                    if goal[x][y] == tile:
                        distance += abs(i - x) + abs(j - y)

    return distance


def get_neighbors(state):
    neighbors = []

    for i in range(3):
        for j in range(3):
            if state[i][j] == 0:
                x = i
                y = j

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    for dx, dy in moves:
        nx = x + dx
        ny = y + dy

        if 0 <= nx < 3 and 0 <= ny < 3:
            new_state = [row[:] for row in state]

            new_state[x][y], new_state[nx][ny] = \
                new_state[nx][ny], new_state[x][y]

            neighbors.append(new_state)

    return neighbors


def print_state(state):
    for row in state:
        print(*row)
    print()


def a_star(initial, goal):

    open_list = []
    closed_list = []

    h = manhattan_distance(initial, goal)

    open_list.append((h, 0, initial, []))

    while open_list:

        open_list.sort(key=lambda x: x[0])

        f, g, current, path = open_list.pop(0)

        if current == goal:
            return path + [current]

        current_tuple = tuple(tuple(row) for row in current)

        if current_tuple in closed_list:
            continue

        closed_list.append(current_tuple)

        for neighbor in get_neighbors(current):

            neighbor_tuple = tuple(tuple(row) for row in neighbor)

            if neighbor_tuple in closed_list:
                continue

            new_g = g + 1
            new_h = manhattan_distance(neighbor, goal)
            new_f = new_g + new_h

            open_list.append(
                (new_f, new_g, neighbor, path + [current])
            )

    return None


# Input Initial State
print("Enter Initial State row by row:")
initial = []

for i in range(3):
    row = list(map(int, input("Enter row: ").split()))
    initial.append(row)


# Input Goal State
print("\nEnter Goal State row by row:")
goal = []

for i in range(3):
    row = list(map(int, input("Enter row: ").split()))
    goal.append(row)


# A* Search
solution = a_star(initial, goal)


# Display Result
if solution:
    print("\nSolution Found!")
    print("Number of moves:", len(solution) - 1)

    print("\nPath:")
    for state in solution:
        print_state(state)
else:
    print("No solution")

